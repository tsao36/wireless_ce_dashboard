# Copy to .env in this folder on the server and replace the example values.
# .env holds real credentials and is git-ignored. Never commit it.

# SMTP relay for category_review_reminder.py
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set both SMTP_USER and SMTP_PASS for an authenticated relay, or leave both empty.
SMTP_USER=your-account@example.com
SMTP_PASS=replace-with-secret
SMTP_FROM=your-account@example.com
# Optional: starttls (default), ssl (default when SMTP_PORT=465), or none (unauthenticated internal relay only)
# SMTP_SECURITY=starttls
# Optional: comma-separated CC list and page link used in reminders
# CATEGORY_REMINDER_CC=lead@example.com
# CATEGORY_PREDICTION_URL=https://dashboard.example.com/category_prediction.html

# Optional loading-quality monitor alerting. Deterministic checks always run after snapshot refreshes.
# AI review sends snapshot finding metadata to the configured internal LLM; leave disabled until approved.
LOADING_QUALITY_AI_ENABLED=0
# LOADING_QUALITY_AI_MODEL=gpt-4.1
# Enable scoped emails to each affected engineer and the supervisor when the anomaly fingerprint changes.
LOADING_QUALITY_EMAIL_ALERTS=0
LOADING_QUALITY_SUPERVISOR_EMAIL=jonathan.tsao@intel.com
# LOADING_QUALITY_ALERT_TO=you@example.com  # Optional recipient override for testing.
# LOADING_QUALITY_MAX_AGE_HOURS=2
# LOADING_QUALITY_OLD_ISSUE_DAYS=30

# Optional shadow classifier for side-by-side issue-category comparison.
# It processes internal IPS comments and can make one LLM request per issue; leave disabled until approved.
CASE_READER_ENABLED=0
# Defaults to the primary configured LLM model when empty.
# CASE_READER_MODEL=gpt-5.4-mini
